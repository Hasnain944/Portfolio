# Public URL of the deployed site. Used for the sitemap, robots.txt and social previews.
# Set this in Vercel (Project Settings > Environment Variables) once you know your domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: a form endpoint (for example from https://formspree.io) so the contact form
# can deliver messages directly. If this is empty, the form opens the visitor's email app instead.
NEXT_PUBLIC_FORM_ENDPOINT=
